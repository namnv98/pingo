<?xml version="1.0" encoding="UTF-8"?>
<Configuration monitorInterval="15">
  <Properties>
    <Property name="default-pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n</Property>
  </Properties>
  <Appenders>
    <Console name="console" target="SYSTEM_OUT">
      <PatternLayout pattern="${default-pattern}"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info" includeLocation="false">
      <AppenderRef ref="console"/>
    </Root>
    <Logger name="org.reflections8.Reflections" level="error" includeLocation="false"/>
    <Logger name="com.hazelcast.internal.server" level="error"/>
  </Loggers>
</Configuration>
